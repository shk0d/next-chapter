{
  "name": "next-chapter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests '*config.ts' package.json tsconfig.json",
    "check": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.57.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
